{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jovi.local/schemas/commerce/c2-contracts.schema.json",
  "title": "Jovi Commerce C2 Contracts",
  "$defs": {
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "asset": {
      "type":"object","additionalProperties":false,
      "required":["relative_path","sha256","size","media_type","rights_status"],
      "properties":{
        "relative_path":{"type":"string","minLength":1},
        "sha256":{"$ref":"#/$defs/sha256"},
        "size":{"type":"integer","minimum":0},
        "media_type":{"type":"string","minLength":1},
        "rights_status":{"const":"original"}
      }
    },
    "product_manifest": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","product_id","name","version","owner","synthetic_only","rights_status","prohibited_content_confirmed_absent","deliverables","acceptance_criteria","assets"],
      "properties":{
        "$schema":{"type":"string"},
        "schema_version":{"const":1},
        "product_id":{"type":"string","minLength":1},
        "name":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "owner":{"type":"string","minLength":1},
        "synthetic_only":{"const":true},
        "rights_status":{"const":"original"},
        "prohibited_content_confirmed_absent":{"const":true},
        "deliverables":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "acceptance_criteria":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "assets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/asset"}}
      }
    },
    "digital_release": {
      "type":"object","additionalProperties":false,
      "required":["release_id","product_id","variant_id","version","state","release_manifest_sha256","source_product_manifest_sha256","rights_evidence_sha256","created_at"],
      "properties":{
        "release_id":{"type":"string"},"product_id":{"type":"string"},"variant_id":{"type":"string"},"version":{"type":"string"},
        "state":{"enum":["DRAFT","READY","FROZEN"]},
        "release_manifest_sha256":{"$ref":"#/$defs/sha256"},"source_product_manifest_sha256":{"$ref":"#/$defs/sha256"},"rights_evidence_sha256":{"$ref":"#/$defs/sha256"},
        "created_at":{"type":"string","format":"date-time"}
      }
    },
    "delivery_package": {
      "type":"object","additionalProperties":false,
      "required":["package_id","release_id","artifact_sha256","manifest_sha256","deterministic_build_id","file_count","total_bytes"],
      "properties":{
        "package_id":{"type":"string"},"release_id":{"type":"string"},"artifact_sha256":{"$ref":"#/$defs/sha256"},"manifest_sha256":{"$ref":"#/$defs/sha256"},
        "deterministic_build_id":{"type":"string"},"file_count":{"type":"integer","minimum":1},"total_bytes":{"type":"integer","minimum":1}
      }
    },
    "download_grant": {
      "type":"object","additionalProperties":false,
      "required":["grant_id","entitlement_id","package_id","token_hash","expires_at","revoked_at","synthetic_only"],
      "properties":{
        "grant_id":{"type":"string"},"entitlement_id":{"type":"string"},"package_id":{"type":"string"},"token_hash":{"$ref":"#/$defs/sha256"},
        "expires_at":{"type":"string","format":"date-time"},"revoked_at":{"type":["string","null"]},"synthetic_only":{"const":true}
      }
    },
    "listing_candidate": {
      "type":"object","additionalProperties":false,
      "required":["candidate_only","platform_action_allowed","title","description","verified_features","version","requirements","delivery_contents","support_boundary","faq","rights_statement","delivery_instructions"],
      "properties":{
        "candidate_only":{"const":true},"platform_action_allowed":{"const":false},"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},
        "verified_features":{"type":"array","items":{"type":"string"}},"version":{"type":"string"},"requirements":{"type":"array","items":{"type":"string"}},
        "delivery_contents":{"type":"array","minItems":1,"items":{"type":"string"}},"support_boundary":{"type":"string"},
        "faq":{"type":"array","items":{"type":"object","required":["q","a"],"properties":{"q":{"type":"string"},"a":{"type":"string"}}}},
        "rights_statement":{"type":"string"},"delivery_instructions":{"type":"string"}
      }
    },
    "xianyu_draft_bundle": {
      "type":"object","additionalProperties":false,
      "required":["candidate_only","platform_action_allowed","publish","send_message","deliver","change_price","refund","listing"],
      "properties":{
        "candidate_only":{"const":true},"platform_action_allowed":{"const":false},"publish":{"const":false},"send_message":{"const":false},"deliver":{"const":false},"change_price":{"const":false},"refund":{"const":false},
        "listing":{"$ref":"#/$defs/listing_candidate"}
      }
    }
  }
}
